                        if dist <= cfg.CarDist then
                            local d = marcaDe(carros, m, m)
                            pcall(function()
                                d.hl.FillColor = Color3.fromRGB(255, 170, 0)
                                d.hl.OutlineColor = Color3.fromRGB(255, 170, 0)
                                d.lbl.Text = "CARRO [" .. math.floor(dist) .. "m]"
                            end)
                        end
                    end
                end
            end
        elseif next(carros) then
            limparTabela(carros)
        end
    end
end))

