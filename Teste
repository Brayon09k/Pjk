acoes.HookPesado = function(v)
    if not (hookfunction and getrawmetatable) then return end
    if not v then return end
    local mt = getrawmetatable(game)
    if mt.__namecall then return end
    local antigo = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local metodo = getnamecallmethod()
        if metodo == "Kick" then
            logKick("kick (hook): " .. tostring(select(1, ...)))
            if cfg.AntiKick then return end
        end
        return antigo(self, ...)
    end)
    setreadonly(mt, true)
end

