local function voltarCamera()
    Camera.CameraType = Enum.CameraType.Custom
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then Camera.CameraSubject = hum end
end

local function teleportarPara(pl)
    local meu = LocalPlayer.Character
    local hrp = meu and meu:FindFirstChild("HumanoidRootPart")
    local alvo = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or not alvo then return end
    local destino = alvo.Position + (alvo.CFrame.LookVector * -cfg.TpDist) + Vector3.new(0, 3, 0)
    pcall(function() meu:PivotTo(CFrame.new(destino)) end)
end

