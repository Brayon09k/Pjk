    l.TextColor3 = COL_TXT; l.BackgroundTransparency = 1; l.Font = "SourceSansBold"; l.TextSize = 12; l.TextXAlignment = "Left"
    local v = Instance.new("TextLabel", f); v.Size = UDim2.new(0, 54, 1, 0); v.Position = UDim2.new(1, -116, 0, 0)
    v.Text = isDecimal and string.format("%.2f", cfg[key]) or tostring(cfg[key])
    v.TextColor3 = COL_GREEN; v.BackgroundTransparency = 1; v.Font = "SourceSansBold"; v.TextSize = 13
    local m = Instance.new("TextButton", f); m.Size = UDim2.new(0, 26, 0, 26); m.Position = UDim2.new(1, -56, 0.5, -13); m.Text = "–"
    m.BackgroundColor3 = Color3.fromRGB(42, 30, 58); m.TextColor3 = COL_TXT; m.TextSize = 17; m.Font = "SourceSansBold"
    Instance.new("UICorner", m).CornerRadius = UDim.new(0, 5)
    local pl = Instance.new("TextButton", f); pl.Size = UDim2.new(0, 26, 0, 26); pl.Position = UDim2.new(1, -26, 0.5, -13); pl.Text = "+"
    pl.BackgroundColor3 = Color3.fromRGB(42, 30, 58); pl.TextColor3 = COL_TXT; pl.TextSize = 17; pl.Font = "SourceSansBold"
    Instance.new("UICorner", pl).CornerRadius = UDim.new(0, 5)

    local debounce = false
    local function updateValue(delta)
        if debounce then return end
        debounce = true
        local newVal = math.clamp(cfg[key] + delta, min, max)
        if cfg[key] ~= newVal then
            cfg[key] = newVal
            v.Text = isDecimal and string.format("%.2f", cfg[key]) or tostring(math.floor(cfg[key]))
        end
        task.wait(0.1)
        debounce = false
    end
    m.MouseButton1Down:Connect(function() updateValue(-(step or 5)) end)
    pl.MouseButton1Down:Connect(function() updateValue(step or 5) end)
