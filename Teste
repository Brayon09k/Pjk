local function marcaDe(tabela, pl, char)
    local d = tabela[pl]
    if d and d.char == char and d.hl and d.hl.Parent then return d end
    if d then
        pcall(function() d.hl:Destroy() end)
        pcall(function() d.bg:Destroy() end)
        pcall(function() if d.linha then d.linha:Remove() end end)
        tabela[pl] = nil
    end
    local nova = criarMarca(pl, char)
    tabela[pl] = nova
    return nova
end

local function pintarMarca(d, visivel, texto, cor)
    pcall(function()
        d.hl.FillColor = cor
        d.hl.OutlineColor = cor
        d.lbl.Text = texto
    end)
    if d.linha then
        pcall(function()
            local cabeca = d.char and (d.char:FindFirstChild("Head") or d.char:FindFirstChild("HumanoidRootPart"))
            if not cabeca then d.linha.Visible = false return end
            local p, onScreen = Camera:WorldToViewportPoint(cabeca.Position)
            if onScreen and visivel then
                d.linha.From = Vector2.new(p.X, p.Y)
                d.linha.To = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                d.linha.Color = cor
                d.linha.Visible = true
            else
                d.linha.Visible = false
            end
        end)
    end
end

-- alvo valido
local function alvoValido(pl, alvoCfg, distMax, checarTime)
    if pl == LocalPlayer then return nil end
    local char = pl.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return nil end
    if checarTime and cfg.SafeTeam and mesmoTime(pl) then return nil end
    local part = char:FindFirstChild(alvoCfg) or hrp
    local dist = (part.Position - Camera.CFrame.Position).Magnitude
    if dist > distMax then return nil end
    local p, onScreen = Camera:WorldToViewportPoint(part.Position)
    if not onScreen then return nil end
    local centro = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2 + cfg.FOVPos)
    local dif = (Vector2.new(p.X, p.Y) - centro).Magnitude
    if dif > cfg.FOVSize then return nil end
    if cfg.AimVisible and not linhaVisao(part.Position) then return nil end
    return part, dif
end

