local kickLogs = {}
local kickLogBox, kickStatus

local function logKick(msg)
    table.insert(kickLogs, 1, "• " .. tostring(msg))
    if #kickLogs > 5 then table.remove(kickLogs) end
    local txt = ""
    for _, l in pairs(kickLogs) do txt = txt .. l .. "\n" end
    if kickLogBox then kickLogBox.Text = txt end
end

local kicksSeguidos = 0
local ultimoKick = 0

local mtGlobal, namecallAntigo
local function soltarHooks()
    pcall(function()
        if mtGlobal and namecallAntigo then
            setreadonly(mtGlobal, false)
            mtGlobal.__namecall = namecallAntigo
            setreadonly(mtGlobal, true)
        end
    end)
    mtGlobal = nil
    namecallAntigo = nil
    cfg._antiKickHooked = false
    cfg.HookPesado = false
    if kickStatus then
        kickStatus.Text = "Ganchos soltos (modo limpo)"
        kickStatus.TextColor3 = Color3.new(1, 0.6, 0)
    end
end

local function reconectarInteligente()
    if cfg._rejoining then return end
    cfg._rejoining = true

    local agora = tick()
    if (agora - ultimoKick) < 90 then
        kicksSeguidos = kicksSeguidos + 1
    else
        kicksSeguidos = 1
    end
    ultimoKick = agora

    if kicksSeguidos >= 2 then
        logKick("2 kicks seguidos - trocando de servidor")
        soltarHooks()
        task.wait(0.4)
        if cfg.AutoTrocarServidor then
            pcall(function() TeleportService:Teleport(game.PlaceId) end)
        else
            pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer) end)
        end
    else
        logKick("reconectando no mesmo servidor")
        pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer) end)
    end

    task.wait(7)
    cfg._rejoining = false
end

local function queueRejoin()
    if cfg._rejoining then return end
    cfg._rejoining = true
    task.delay(3, function()
        pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
        end)
        task.wait(8)
        cfg._rejoining = false
    end)
end

function setupAntiKick()
    if cfg._antiKickHooked then return true end

    local ok = false

    if hookfunction and newcclosure then
        ok = pcall(function()
            local antigo = LocalPlayer.Kick
            hookfunction(antigo, newcclosure(function(self, msg)
                if cfg.AntiKick then
                    logKick(tostring(msg or "sem mensagem"))
                    task.spawn(reconectarInteligente)
                    return
                end
                return antigo(self, msg)
            end))
        end)
    end

    if cfg.HookPesado then
        pcall(function()
            local mt = getrawmetatable(game)
            if not mt or not mt.__namecall then return end
            mtGlobal = mt
            namecallAntigo = mt.__namecall
            local eraRO = true
            pcall(function() eraRO = isreadonly(mt) end)
            setreadonly(mt, false)
            mt.__namecall = newcclosure(function(self, ...)
                if getnamecallmethod() == "Kick" and self == LocalPlayer then
                    if cfg.AntiKick then
                        local args = { ... }
                        logKick(tostring(args[1] or "sem mensagem"))
                        task.spawn(reconectarInteligente)
                        return
                    end
                end
                return namecallAntigo(self, ...)
            end)
            setreadonly(mt, eraRO)
            ok = true
        end)
    end

    cfg._antiKickHooked = ok
    if kickStatus then
        kickStatus.Text = ok and "Hook ativo" or "Hook indisponível (usar rejoin)"
        kickStatus.TextColor3 = ok and Color3.new(0,1,0) or Color3.new(1,0.6,0)
    end
    return ok
end

task.spawn(function()
    task.wait(1)
    if cfg.AntiKick then setupAntiKick() end
end)

