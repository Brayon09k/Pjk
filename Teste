    p.Visible = false
    local pad = Instance.new("UIPadding", p)
    pad.PaddingBottom = UDim.new(0, 14)
    local l = Instance.new("UIListLayout", p)
    l.Padding = UDim.new(0, 6)
    l.SortOrder = Enum.SortOrder.LayoutOrder
    local function atualiza()
        task.defer(function()
            if p.Parent then
                p.CanvasSize = UDim2.new(0, 0, 0, l.AbsoluteContentSize.Y + 20)
            end
        end)
    end
    p.ChildAdded:Connect(atualiza)
    p.ChildRemoved:Connect(atualiza)
    l:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(atualiza)
    return p
end

