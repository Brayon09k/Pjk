local carESP = {}
local CAR_KEYWORDS = {"car","veiculo","veículo","vehicle","truck","caminh","bike","moto","bus","onibus","ônibus","jeep","suv","taxi","táxi","kart","boat","barco","plane","aviao","avião","heli","tank","van","pickup"}

local function nameIsCar(inst)
    local n = inst.Name:lower()
    for _, k in ipairs(CAR_KEYWORDS) do
        if n:find(k, 1, true) then return true end
    end
    return false
end

local function isVehicle(inst)
    if inst:IsA("Model") then
        if nameIsCar(inst) then return true end
        if inst:FindFirstChildWhichIsA("VehicleSeat", true) then return true end
        return false
    elseif inst:IsA("BasePart") then
        return nameIsCar(inst)
    end
    return false
end

local function carRoot(inst)
    if inst:IsA("BasePart") then return inst end
    return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")
end

local function clearCarESP()
    for inst, data in pairs(carESP) do
        pcall(function()
            if data.hl then data.hl:Destroy() end
            if data.bb then data.bb:Destroy() end
        end)
        carESP[inst] = nil
    end
end

local function trackCar(inst)
    local root = carRoot(inst)
    if not root then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = COL_VIS; hl.OutlineColor = Color3.new(1,1,1)
    hl.FillTransparency = 0.55; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = inst
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 140, 0, 26); bb.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true; bb.MaxDistance = 5000; bb.Parent = root
    local lbl = Instance.new("TextLabel", bb)
    lbl.Size = UDim2.new(1, 0, 1, 0); lbl.BackgroundTransparency = 1
    lbl.Text = inst.Name; lbl.TextColor3 = COL_VIS
    lbl.Font = "SourceSansBold"; lbl.TextSize = 12; lbl.TextStrokeTransparency = 0.3
    carESP[inst] = {hl = hl, bb = bb, lbl = lbl, root = root}
end

local function scanCars()
    local char = LocalPlayer.Character
    local origin = (char and char:FindFirstChild("HumanoidRootPart")) and char.HumanoidRootPart.Position or Camera.CFrame.Position
    local maxD = cfg.CarDist * 1.6
    local found = {}
    local count = 0
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst:IsA("Model") and isVehicle(inst) then
            local root = carRoot(inst)
            if root and (root.Position - origin).Magnitude <= maxD then
