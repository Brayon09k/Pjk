local rejoinLock = false
local function tentarVoltar()
    if rejoinLock then return end
    rejoinLock = true
    task.spawn(function()
        for _ = 1, 2 do
            pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
            end)
            task.wait(5)
            if Players.LocalPlayer and Players.LocalPlayer.Parent then break end
        end
