local function linhaVisao(pos)
    local char = LocalPlayer.Character
    if not char then return false end
    paramsRaio.FilterDescendantsInstances = {char, Camera}
    local res = workspace:Raycast(Camera.CFrame.Position, pos - Camera.CFrame.Position, paramsRaio)
    return res == nil
end

