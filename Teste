    m.BackgroundColor3 = Color3.fromRGB(30, 38, 30); m.TextColor3 = COL_TXT; m.TextSize = 18; m.Font = "SourceSansBold"
    Instance.new("UICorner", m).CornerRadius = UDim.new(0, 6)
    local pl = Instance.new("TextButton", f); pl.Size = UDim2.new(0, 28, 0, 28); pl.Position = UDim2.new(1, -28, 0.5, -14); pl.Text = "+"
