    lbl.BackgroundTransparency = 1; lbl.TextXAlignment = "Left"; lbl.Font = "SourceSansBold"
    lbl.TextSize = 13; lbl.TextColor3 = COL_TXT; lbl.TextTruncate = Enum.TextTruncate.AtEnd

    local track = Instance.new("Frame", b)
    track.Size = UDim2.new(0, 40, 0, 20); track.Position = UDim2.new(1, -50, 0.5, -10)
    track.BackgroundColor3 = COL_OFF
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    local knob = Instance.new("Frame", track)
    knob.Size = UDim2.new(0, 14, 0, 14); knob.Position = UDim2.new(0, 3, 0.5, -7)
    knob.BackgroundColor3 = Color3.new(1,1,1)
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    b.MouseButton1Click:Connect(function()
        if id == "AimbotForte" then cfg.AimbotMode = (cfg.AimbotMode == "Forte") and "None" or "Forte"
        elseif id == "AimbotFraco" then cfg.AimbotMode = (cfg.AimbotMode == "Fraco") and "None" or "Fraco"
        elseif id == "NpcAimbotForte" then cfg.NpcAimbotMode = (cfg.NpcAimbotMode == "Forte") and "None" or "Forte"
        elseif id == "NpcAimbotFraco" then cfg.NpcAimbotMode = (cfg.NpcAimbotMode == "Fraco") and "None" or "Fraco"
        elseif id == "Spin" then
            cfg.Spin = not cfg.Spin
            if cfg.Spin then startSpin() else stopSpin() end
        elseif id == "KickHook" then
            cfg.KickHook = not cfg.KickHook
            if cfg.KickHook then setupAntiKick() end
        elseif id == "HookPesado" then
            cfg.HookPesado = not cfg.HookPesado
            if cfg.HookPesado then
                cfg._antiKickHooked = false
                cfg.KickHook = true
                setupAntiKick()
            end
        elseif id == "SpeedOn" then
            cfg.SpeedOn = not cfg.SpeedOn
            if not cfg.SpeedOn then
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum then hum.WalkSpeed = 16 end
            end
        elseif id == "Discreto" then
            cfg.Discreto = not cfg.Discreto
            if cfg.Discreto then
                cfg.KickHook = false; cfg.HookPesado = false; cfg.God = false
                cfg.AntiScreenshot = true; cfg.AntiDetector = true
            end
        elseif id == "MaxProt" then
            cfg.MaxProt = not cfg.MaxProt
            if cfg.MaxProt then
                cfg.AutoVoltar = true; cfg.AntiAFK = true
                cfg.AntiScreenshot = true; cfg.AntiDetector = true; cfg.God = true
            end
        else cfg[id] = not cfg[id] end
    end)

    local last = nil
    RunService.RenderStepped:Connect(function()
        local act = (id == "AimbotForte" and cfg.AimbotMode == "Forte")
            or (id == "AimbotFraco" and cfg.AimbotMode == "Fraco")
            or (id == "NpcAimbotForte" and cfg.NpcAimbotMode == "Forte")
            or (id == "NpcAimbotFraco" and cfg.NpcAimbotMode == "Fraco")
            or (cfg[id] == true)
        if act == last then return end
        last = act
        lbl.Text = name .. (suffix and (act and "  •  ON" or "  •  OFF") or "")
        lbl.TextColor3 = act and COL_GREEN or COL_TXT
        track.BackgroundColor3 = act and COL_ON or COL_OFF
        st.Color = act and COL_GREEN or COL_ROW_STROKE
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = act and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
        }):Play()
    end)
end

