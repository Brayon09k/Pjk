-- ============================================================
local fps, frames, tempo = 0, 0, 0

RunService.RenderStepped:Connect(safe(function(dt)
    -- fps
    frames = frames + 1
    tempo = tempo + dt
    if tempo >= 1 then
        fps = math.floor(frames / tempo)
        frames = 0
        tempo = 0
        fpsTxt.Text = tostring(fps)
        local ok, ping = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        pingTxt.Text = ok and (math.floor(ping) .. " ms") or "--"
        contadorLabel.Text = "JOGADORES: " .. #Players:GetPlayers()
    end

    -- HUD
    hud.Visible = main.Visible
    hud.Position = UDim2.new(1, -138, 0, main.Visible and (main.AbsolutePosition.Y + 8) or 12)
    hud.Position = UDim2.new(1, -138, 0, main.Position.Y.Offset + main.AbsoluteSize.Y - 70)

    -- painel
    main.BackgroundTransparency = cfg.Transp and 0.45 or 0.12
    if cfg.LEDActive then
        local h = (tick() * cfg.LEDSpeed) % 1
        accent = Color3.fromHSV(h, 0.7, 1)
        bordaMain.Color = accent
        bordaBola.Color = accent
        fovStroke.Color = accent
        hudStroke.Color = accent
    end

    -- fov
    fovFrame.Visible = cfg.FOV
    if cfg.FOV then
        fovFrame.Size = UDim2.new(0, cfg.FOVSize * 2, 0, cfg.FOVSize * 2)
        fovFrame.Position = UDim2.new(0.5, 0, 0.5, cfg.FOVPos)
    end

    -- esp jogadores
    if cfg.ESP then
        local vistos = {}
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LocalPlayer then
                local char = pl.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 and not (cfg.SafeTeam and mesmoTime(pl)) then
                    vistos[pl] = true
                    local d = marcaDe(marcas, pl, char)
                    local visivel = linhaVisao(hrp.Position)
                    local dist = math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)
                    local cor = visivel and Color3.fromRGB(0, 255, 90) or Color3.new(0, 0, 0)
                    pintarMarca(d, visivel, pl.Name .. " [" .. dist .. "m]", cor)
                end
            end
        end
        for pl, d in pairs(marcas) do
            if not vistos[pl] then
                pcall(function() d.hl:Destroy() end)
                pcall(function() d.bg:Destroy() end)
                pcall(function() if d.linha then d.linha:Remove() end end)
                marcas[pl] = nil
            end
        end
    end

    -- esp npc
    if cfg.NpcESP then
        for _, m in ipairs(workspace:GetChildren()) do
            if m:IsA("Model") and m ~= LocalPlayer.Character then
                local hum = m:FindFirstChildOfClass("Humanoid")
                local hrp = m:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 and not Players:GetPlayerFromCharacter(m) then
                    local dist = (hrp.Position - Camera.CFrame.Position).Magnitude
                    if dist <= cfg.NpcDist then
                        local d = marcaDe(marcasNpc, m, m)
                        local visivel = linhaVisao(hrp.Position)
                        local cor = visivel and Color3.fromRGB(0, 255, 90) or Color3.new(0, 0, 0)
                        pintarMarca(d, visivel, m.Name .. " [" .. math.floor(dist) .. "m]", cor)
                    end
                end
            end
        end
    end

    -- velocidade
    if cfg.SpeedOn then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hum.WalkSpeed ~= cfg.Speed then hum.WalkSpeed = cfg.Speed end
    end

    -- deus
    if cfg.Deus then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.MaxHealth = math.huge; hum.Health = math.huge end
    end

    -- log
    logLabel.Text = table.concat(kicks, "\n")
end))

-- ============================================================
-- AIMBOT
-- ============================================================
RunService:BindToRenderStep("MZ_AIM", Enum.RenderPriority.Camera.Value + 1, safe(function(dt)
    if not cfg.FOV then return end
    local alvo, menor = nil, math.huge

    if cfg.AimbotForte or cfg.AimbotFraco then
        for _, pl in ipairs(Players:GetPlayers()) do
            local part, dif = alvoValido(pl, cfg.TargetPart, cfg.AimNear and cfg.AimDist or 5000, true)
            if part and dif < menor then
                menor = dif
                alvo = part
            end
        end
    end

    if not alvo and (cfg.NpcAimbotForte or cfg.NpcAimbotFraco) then
        for _, m in ipairs(workspace:GetChildren()) do
            if m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then
                local hum = m:FindFirstChildOfClass("Humanoid")
                local hrp = m:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    local part = m:FindFirstChild(cfg.NpcTarget) or hrp
                    local dist = (part.Position - Camera.CFrame.Position).Magnitude
                    if dist <= cfg.NpcDist then
                        local p, on = Camera:WorldToViewportPoint(part.Position)
                        local centro = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2 + cfg.FOVPos)
                        local dif = (Vector2.new(p.X, p.Y) - centro).Magnitude
                        if on and dif <= cfg.FOVSize and linhaVisao(part.Position) and dif < menor then
                            menor = dif
                            alvo = part
                        end
                    end
                end
            end
        end
    end

    if not alvo then return end
    local destino = CFrame.lookAt(Camera.CFrame.Position, alvo.Position)
    if cfg.AimbotForte or cfg.NpcAimbotForte then
        Camera.CFrame = destino
    else
        Camera.CFrame = Camera.CFrame:Lerp(destino, math.clamp(dt * 14, 0, 1))
    end
end))

