    end)
end

function setupAntiKick()
    if cfg._antiKickHooked then return true end
    local ok = false

    if cfg.KickHook then
        ok = pcall(function()
            local oldKick = LocalPlayer.Kick
            hookfunction(oldKick, function(self, msg)
                if cfg.KickHook then
                    logKick(tostring(msg or "sem mensagem"))
                    tentarVoltar()
                    return
                end
                return oldKick(self, msg)
            end)
        end)
    end

    if cfg.HookPesado then
        local ok2 = pcall(function()
            local mt = getrawmetatable(game)
            if not mt then error("sem metatable") end
            local oldNamecall = mt.__namecall
            local eraReadonly = isreadonly(mt)
            setreadonly(mt, false)
            mt.__namecall = newcclosure(function(self, ...)
                local method = getnamecallmethod()
                if method == "Kick" and self == LocalPlayer then
                    if cfg.KickHook then
                        local args = { ... }
                        logKick(tostring(args[1] or "sem mensagem"))
                        tentarVoltar()
                        return
                    end
                end
                return oldNamecall(self, ...)
            end)
            setreadonly(mt, eraReadonly)
        end)
        ok = ok or ok2
    end

    cfg._antiKickHooked = ok
    if kickStatus then
        kickStatus.Text = ok and "Hook ativo" or "Hook desligado (só vigia)"
        kickStatus.TextColor3 = ok and COL_VIS or COL_DIM
    end
    return ok
end

