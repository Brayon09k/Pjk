    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1, -62, 0, desc and 22 or 34)
    lbl.Position = UDim2.new(0, 10, 0, desc and 4 or 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = nome
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 13
    lbl.TextColor3 = COL_TXT

    if desc then
        local d = Instance.new("TextLabel", row)
        d.Size = UDim2.new(1, -62, 0, 14)
        d.Position = UDim2.new(0, 10, 0, 26)
        d.BackgroundTransparency = 1
        d.Text = desc
        d.TextXAlignment = Enum.TextXAlignment.Left
        d.Font = Enum.Font.Gotham
        d.TextSize = 10
        d.TextColor3 = COL_DIM
    end

    local estado = Instance.new("TextLabel", row)
    estado.Size = UDim2.new(0, 44, 0, 20)
    estado.Position = UDim2.new(1, -50, 0.5, -10)
    estado.BackgroundTransparency = 1
    estado.Font = Enum.Font.GothamBold
    estado.TextSize = 12

    local function pinta()
        if cfg[id] then
            estado.Text = "ON"
            estado.TextColor3 = COL_ON
            row.BackgroundColor3 = Color3.fromRGB(62, 38, 100)
            row.BackgroundTransparency = 0.15
        else
            estado.Text = "OFF"
            estado.TextColor3 = COL_DIM
            row.BackgroundColor3 = COL_CARD
            row.BackgroundTransparency = 0.4
        end
    end
    pinta()

    row.MouseButton1Click:Connect(function()
        cfg[id] = not cfg[id]
        pinta()
        local cb = acoes[id]
        if cb then task.spawn(safe(function() cb(cfg[id]) end)) end
    end)

    return row
