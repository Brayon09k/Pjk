    local hum = copia:FindFirstChildOfClass("Humanoid")
    if hum then hum:Destroy() end
    for _, d in ipairs(copia:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Anchored = true
            d.CanCollide = false
        end
    end
