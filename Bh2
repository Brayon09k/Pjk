local function newPage()
    local p = Instance.new("ScrollingFrame", main)
    p.Size = UDim2.new(0, 330, 0, 220); p.Position = UDim2.new(0, 12, 0, 78)
    p.BackgroundTransparency = 1; p.BorderSizePixel = 0
    p.ScrollingDirection = Enum.ScrollingDirection.Y
    p.ScrollBarThickness = 5; p.ScrollBarImageColor3 = COL_GREEN
    p.ElasticBehavior = Enum.ElasticBehavior.WhenScrollable
    p.ScrollingEnabled = true
    p.Active = true
    p.AutomaticCanvasSize = Enum.AutomaticSize.None
    p.CanvasSize = UDim2.new(0, 0, 0, 0)
    p.Visible = false
    local pad = Instance.new("UIPadding", p)
    pad.PaddingBottom = UDim.new(0, 10)
    local l = Instance.new("UIListLayout", p)
    l.Padding = UDim.new(0, 6); l.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout[p] = l

    local function refresh()
        p.CanvasSize = UDim2.new(0, 0, 0, l.AbsoluteContentSize.Y + 12)
    end
    l:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refresh)
    p.ChildAdded:Connect(function() task.defer(refresh) end)
    p.ChildRemoved:Connect(function() task.defer(refresh) end)
    task.defer(refresh)
    return p
end

