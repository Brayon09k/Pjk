-- ========== PREVIEW 3D (com fallback) ==========
local function limparPreview()
    if previewModel then
        pcall(function() previewModel:Destroy() end)
    end
    previewModel = nil
end

local function montarPreview()
    if not vp or not vpCam then return end
    limparPreview()
    local char = LocalPlayer.Character
    if not char then return end

    local arch = char.Archivable
    if not arch then pcall(function() char.Archivable = true end) end
    local ok, clone = pcall(char.Clone, char)
    if not arch then pcall(function() char.Archivable = false end) end

    if not ok or not clone then
        if vpAviso then vpAviso.Text = "personagem indisponível" end
        return
    end

    for _, d in ipairs(clone:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Anchored = true
            d.CanCollide = false
            d.Massless = true
            d.Transparency = 0
        end
    end
    local hum = clone:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum:Destroy() end) end

    local raiz = clone:FindFirstChild("HumanoidRootPart") or clone:FindFirstChildWhichIsA("BasePart")
    if not raiz then
        pcall(function() clone:Destroy() end)
        if vpAviso then vpAviso.Text = "personagem indisponível" end
        return
    end
    clone.PrimaryPart = raiz

    local okPiv = pcall(function() clone:PivotTo(CFrame.new(0, 0, 0)) end)
    if not okPiv then
        pcall(function()
            local base = raiz.CFrame
            for _, d in ipairs(clone:GetDescendants()) do
                if d:IsA("BasePart") then
                    d.CFrame = base:ToObjectSpace(d.CFrame)
                end
            end
        end)
    end

    local altura = 5
    pcall(function() altura = math.max(clone:GetExtentsSize().Y, 2) end)
    local dist = altura * 1.9
    vpCam.CFrame = CFrame.lookAt(Vector3.new(0, 0.5, dist), Vector3.new(0, 0, 0))

    clone.Parent = vp
    previewModel = clone
    if vpAviso then vpAviso.Visible = false end
end

task.spawn(function()
    task.wait(1)
    pcall(montarPreview)
    while mainGui.Parent do
        task.wait(3)
        pcall(montarPreview)
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
