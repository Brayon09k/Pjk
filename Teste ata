-- REJOIN REFORÇADO (mesmo servidor, com repetição)
local function queueRejoin()
    if cfg._rejoining or not cfg.AutoReconnect then return end
    cfg._rejoining = true
    local job = game.JobId
    local place = game.PlaceId

    task.delay(1.2, function()
        pcall(function() TeleportService:TeleportToPlaceInstance(place, job, LocalPlayer) end)
    end)

    task.delay(4.5, function()
        if game.JobId == job then
            pcall(function() TeleportService:TeleportToPlaceInstance(place, job, LocalPlayer) end)
        end
    end)

    task.delay(8.5, function()
        if game.JobId == job then
            pcall(function() TeleportService:Teleport(place, LocalPlayer) end)
        end
    end)

    task.delay(13, function() cfg._rejoining = false end)
end

-- HOOK ANTI KICK (não deixa o cliente travado)
function setupAntiKick()
    if cfg._antiKickHooked then return true end

    local ok = pcall(function()
        local mt = getrawmetatable(game)
        if not mt then error("sem metatable") end
        local oldNamecall = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "Kick" and self == LocalPlayer and cfg.AntiKick then
                local args = { ... }
                pcall(logKick, tostring(args[1] or "sem mensagem"))
                queueRejoin()
                return
            end
            return oldNamecall(self, ...)
        end)
        setreadonly(mt, true)
    end)

    if not ok then
        ok = pcall(function()
            local oldKick = hookfunction(LocalPlayer.Kick, function(self, msg)
                if cfg.AntiKick then
                    pcall(logKick, tostring(msg or "sem mensagem"))
                    queueRejoin()
                    return
                end
                return oldKick(self, msg)
            end)
        end)
    end

    cfg._antiKickHooked = ok
    if kickStatus then
        kickStatus.Text = ok and "Hook: ATIVO" or "Hook: indisponível (só rejoin)"
        kickStatus.TextColor3 = ok and NEON or Color3.fromRGB(255, 160, 60)
    end
    return ok
end

