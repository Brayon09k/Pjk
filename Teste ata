local RENDER_NAME = "MzUrielRender"
pcall(function() RunService:UnbindFromRenderStep(RENDER_NAME) end)

RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Camera.Value + 1, function()
    local cam = getCam()
    if not cam then return end

    -- VISUAL DO PAINEL
    local okVis = pcall(function()
        fovFrame.Visible = cfg.FOV
        fovFrame.Size = UDim2.new(0, cfg.FOVSize*2, 0, cfg.FOVSize*2)
        fovFrame.Position = UDim2.new(0.5, -cfg.FOVSize, 0.5, -cfg.FOVSize + cfg.FOVPos)

        local bgColor = getRealColor()
        local darkBg = Color3.new(bgColor.R * 0.15, bgColor.G * 0.15, bgColor.B * 0.15)
        main.BackgroundColor3 = darkBg
        confirmFrame.BackgroundColor3 = darkBg
        main.BackgroundTransparency = cfg.Transparency
        confirmFrame.BackgroundTransparency = cfg.Transparency

        local borderColor
        if cfg.LEDActive then
            local hue = (tick() * (cfg.LEDSpeed / 10)) % 1
            borderColor = Color3.fromHSV(hue, 1, 1)
        else
            borderColor = bgColor
        end

        fovStroke.Color = borderColor
        mStroke.Color = borderColor
        bStroke.Color = borderColor
        cStroke.Color = borderColor
        title.TextColor3 = borderColor
    end)

    -- ESP
    local espErr = nil
    local okEsp, errEsp = pcall(function()
        if cfg.ESP then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    updateESP(player, getRealColor(), cam)
                end
            end
        else
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    clearESP(player)
                end
            end
        end
    end)
    if not okEsp then espErr = tostring(errEsp) end

    -- AIMBOT
    local target = nil
    local dist = cfg.FOVSize
    local center = Vector2.new(cam.ViewportSize.X/2, (cam.ViewportSize.Y/2) + cfg.FOVPos)

    local okAim, errAim = pcall(function()
        if cfg.AimbotMode ~= "None" then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local char = player.Character
                    local isTeammate = (player.Team == LocalPlayer.Team)
                    if char and not (cfg.SafeTeam and isTeammate) then
                        local humanoid = char:FindFirstChild("Humanoid")
                        if humanoid and humanoid.Health > 0 then
                            local part = getPrecisePart(char, cfg.TargetPart)
                            if part then
                                local pos, vis = cam:WorldToViewportPoint(part.Position)
                                if vis then
                                    local mDist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                                    if mDist <= cfg.FOVSize and mDist < dist then
                                        dist = mDist
                                        target = part
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    if target then
        cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, target.Position), (cfg.AimbotMode == "Forte" and 1 or 0.15))
    end

    -- DIAGNÓSTICO
    pcall(function()
        dbg.Text = string.format("cam:%s alvo:%s | erro:%s",
            cam and "ok" or "nil",
            target and "SIM" or "nao",
            espErr and "ESP" or (okAim and "-" or "AIM"))
    end)
end)

