local function temVisao(part)
    local ok, res = pcall(function()
        local char = LocalPlayer.Character
        local filtro = {}
        if char then table.insert(filtro, char) end
        if part.Parent then table.insert(filtro, part.Parent) end
        rayParams.FilterDescendantsInstances = filtro
        local origem = Camera.CFrame.Position
        local hit = workspace:Raycast(origem, part.Position - origem, rayParams)
        if not hit then return true end
        if hit.Instance == part then return true end
        if hit.Instance.Parent and hit.Instance:IsDescendantOf(part.Parent) then return true end
        return false
    end)
    if not ok then return true end
    return res
end

local function getPrecisePart(char, partName)
    if partName == "Head" then return char:FindFirstChild("Head")
    elseif partName == "Torso" then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    elseif partName == "RightArm" then return char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm")
    elseif partName == "LeftArm" then return char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm")
    elseif partName == "Legs" then return char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg") end
    return nil
end

local function createTracer()
    local line = Drawing.new("Line")
    line.Thickness = 1.5
    line.Transparency = 1
    line.Visible = false
    return line
end

local tracers = {}
local highlights = {}

local COL_VIS   = Color3.fromRGB(0, 255, 90)
local COL_HIDDEN = Color3.fromRGB(0, 0, 0)
local COL_OUTLINE_HIDDEN = Color3.fromRGB(45, 45, 45)

local function clearESP(player)
    local line = tracers[player]
    if line then line.Visible = false end
    local hl = highlights[player]
    if hl then
        pcall(function() hl:Destroy() end)
        highlights[player] = nil
    end
end

local function updateESP(player, color)
    local char = player.Character
    local isTeammate = (player.Team == LocalPlayer.Team)
    local line = tracers[player]
    if not line then
        line = createTracer()
        tracers[player] = line
    end

    if not cfg.ESP then
        line.Visible = false
        return
    end

    if char and char:FindFirstChild("HumanoidRootPart") then
        local humanoid = char:FindFirstChild("Humanoid")
        local isAlive = humanoid and humanoid.Health > 0
        if not isAlive then
            clearESP(player)
            return
        end

        local root = char.HumanoidRootPart
        local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
        local inFront = Camera.CFrame:PointToObjectSpace(root.Position).Z < 0
        local visivel = onScreen and inFront

        local hl = highlights[player]

        if not (cfg.SafeTeam and isTeammate) then
            if not hl then
                hl = Instance.new("Highlight")
                hl.Name = "MzHighlight"
                hl.Parent = char
                highlights[player] = hl
            end
            hl.FillColor = visivel and COL_VIS or COL_HIDDEN
            hl.OutlineColor = visivel and Color3.new(1,1,1) or COL_OUTLINE_HIDDEN
            hl.Enabled = true

            if inFront then
                line.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                line.To = Vector2.new(pos.X, pos.Y)
                line.Color = visivel and COL_VIS or COL_HIDDEN
                line.Visible = true
            else
                line.Visible = false
            end
        else
            if hl then
                hl:Destroy()
                highlights[player] = nil
            end
            line.Visible = false
        end
    else
        clearESP(player)
    end
end

