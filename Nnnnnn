local ultimoTiro = 0

local function matarNaMira()
    local centro = Vector2.new(Camera.ViewportSize.X/2, (Camera.ViewportSize.Y/2) + cfg.FOVPos)
    local melhor, melhorD = nil, cfg.FOVSize

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer then
            local char = pl.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local alvo = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
            if hum and hum.Health > 0 and alvo and not (cfg.SafeTeam and pl.Team == LocalPlayer.Team) then
                local p, on = Camera:WorldToViewportPoint(alvo.Position)
                if on then
                    local d = (Vector2.new(p.X, p.Y) - centro).Magnitude
                    if d < melhorD and temVisao(alvo) then
                        melhorD = d
                        melhor = hum
                    end
                end
            end
        end
    end

    if not melhor then
        for model, data in pairs(npcESP) do
            local hum = model:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and data.root then
                local p, on = Camera:WorldToViewportPoint(data.root.Position)
                if on then
                    local d = (Vector2.new(p.X, p.Y) - centro).Magnitude
                    if d < melhorD and temVisao(data.root) then
                        melhorD = d
                        melhor = hum
                    end
                end
            end
        end
    end

    if melhor then
        pcall(function() melhor:TakeDamage(melhor.MaxHealth + 500) end)
        pcall(function() melhor.Health = 0 end)
    end
end

