-- ================= AIMBOT =================
local function loopAimbot()
    local querJogador = (cfg.AimbotMode ~= "None" and cfg.FOV)
    local querNpc = (cfg.NpcAimbotMode ~= "None" and cfg.NpcFOV)
    if not querJogador and not querNpc then return end

    local meuChar = LocalPlayer.Character
    local meuRoot = meuChar and meuChar:FindFirstChild("HumanoidRootPart")

    local target = nil
    local dist = cfg.FOVSize
    local center = Vector2.new(Camera.ViewportSize.X/2, (Camera.ViewportSize.Y/2) + cfg.FOVPos)

    if querJogador then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                local isTeammate = (player.Team == LocalPlayer.Team)
                if char and not (cfg.SafeTeam and isTeammate) then
                    local humanoid = char:FindFirstChild("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        local part = getPrecisePart(char, cfg.TargetPart)
                        if part then
                            local perto = true
                            if cfg.AimNear and meuRoot then
                                perto = (part.Position - meuRoot.Position).Magnitude <= cfg.AimDist
                            end
                            if perto and (not cfg.AimVisible or temVisao(part)) then
                                local pos, vis = Camera:WorldToViewportPoint(part.Position)
                                if vis then
                                    local mDist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                                    if mDist <= cfg.FOVSize and mDist < dist then
                                        dist = mDist
                                        target = part
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if querNpc then
        for model, data in pairs(npcESP) do
            pcall(function()
                local root = data.root
                if root and root.Parent then
                    local hum = model:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local part = getPrecisePart(model, cfg.NpcTarget)
                        if part then
                            local perto = true
                            if cfg.AimNear and meuRoot then
                                perto = (part.Position - meuRoot.Position).Magnitude <= cfg.AimDist
                            end
                            if perto and (not cfg.AimVisible or temVisao(part)) then
                                local pos, vis = Camera:WorldToViewportPoint(part.Position)
                                if vis then
                                    local mDist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                                    if mDist <= cfg.FOVSize and mDist < dist then
                                        dist = mDist
                                        target = part
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end

    if target then
        fovStroke.Color = COL_VIS
        local forca = (cfg.AimbotMode == "Forte" or cfg.NpcAimbotMode == "Forte") and 1 or 0.2
        local atual = Camera.CFrame
        local nova = CFrame.new(atual.Position, target.Position)
        if forca >= 1 then
            Camera.CFrame = nova
        else
            Camera.CFrame = atual:Lerp(nova, forca)
        end
    end
end

