local function addStepper(name, key, min, max, p, step, isDecimal)
    local f = Instance.new("Frame", p); f.Size = UDim2.new(0.95, 0, 0, 50); f.BackgroundTransparency = 1
    if p == cAju then f.LayoutOrder = orderAju; orderAju = orderAju + 1 end
    local v = Instance.new("TextLabel", f); v.Size = UDim2.new(1, 0, 0, 28); v.Position = UDim2.new(0, 0, 0, 20); v.Text = isDecimal and string.format("%.2f", cfg[key]) or tostring(cfg[key]); v.TextColor3 = Color3.new(1,1,1); v.BackgroundTransparency = 1; v.Font = "SourceSansBold"; v.TextSize = 18
    local l = Instance.new("TextLabel", f); l.Size = UDim2.new(1, 0, 0, 18); l.Text = name; l.TextColor3 = Color3.new(0.8,0.8,0.8); l.BackgroundTransparency = 1
    local m = Instance.new("TextButton", f); m.Size = UDim2.new(0, 45, 0, 35); m.Position = UDim2.new(0, 5, 0, 18); m.Text = "-"; m.BackgroundColor3 = Color3.fromRGB(30,30,30); m.TextColor3 = Color3.new(1,1,1); Instance.new("UICorner", m).CornerRadius = UDim.new(0, 6)
    local pl = Instance.new("TextButton", f); pl.Size = UDim2.new(0, 45, 0, 35); pl.Position = UDim2.new(1, -50, 0, 18); pl.Text = "+"; pl.BackgroundColor3 = Color3.fromRGB(30,30,30); pl.TextColor3 = Color3.new(1,1,1); Instance.new("UICorner", pl).CornerRadius = UDim.new(0, 6)
    
    local debounce = false
    local function updateValue(delta)
        if debounce then return end
        debounce = true
        local newVal = math.clamp(cfg[key] + delta, min, max)
        if cfg[key] ~= newVal then
            cfg[key] = newVal
            v.Text = isDecimal and string.format("%.2f", cfg[key]) or tostring(math.floor(cfg[key]))
        end
        task.wait(0.1)
        debounce = false
    end
    
    m.MouseButton1Down:Connect(function() updateValue(-(step or 5)) end)
    pl.MouseButton1Down:Connect(function() updateValue(step or 5) end)
end

